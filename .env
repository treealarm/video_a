# video_a is a standalone, dependency-light analytics engine — these are its own conventions,
# independent of ta_vms's .env (no APP_ID/PUBSUB_NAME/DAPR_CFG_APP_ID etc. needed: video_a never
# calls anyone itself, it only accepts calls).

ANALYTICS_GRPC_PORT=50060

# Where a producer publishes a stream for this worker to analyse, instead of the worker reading
# it back out of a media router alongside the operator -- two readers of one high-bitrate path is
# what makes the operator's live view stutter. The worker opens this port and answers StartWatch
# with the address; the host is what it is reachable at from the producer, which a container
# cannot work out for itself.
ANALYTICS_ADVERTISE_HOST=analytics-worker
# Not 8554: that is the RTSP port a media router already answers on, and in a dev setup where
# both run on one host the bind would simply fail ("Unable to open RTSP for listening").
ANALYTICS_RTSP_PORT=8555
ANALYTICS_MODEL_PATH=/models
ANALYTICS_DEVICE=CPU

# Re-identification: how often (seconds, 1..86400) a still-live track recomputes its body
# embedding. It is computed on a track's first frame (START) and then at most once per interval;
# the latest vector rides along with every detection of that track, so this bounds the inference
# cost, not how often the consumer sees an embedding.
# Requires a person_embedder model (models/person_embedder.[onnx|xml]) — without it body re-id is
# simply disabled and the embedding field stays empty.
ANALYTICS_REID_EMBED_INTERVAL_SEC=15

# Optional, dev/test-only: when models are absent (Phase 1 stub inference), periodically emit one
# synthetic PERSON detection so the whole pipeline (StreamDetections -> VmsAnalytics ->
# RetainEvent -> ListDetections) is exercisable end-to-end without real models. Must stay unset
# ("false"/absent) once real models are wired in.
ANALYTICS_STUB_SYNTHETIC_DETECTIONS=false
